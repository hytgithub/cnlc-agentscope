# Use demo mode for the complete W01-W10 presentation path; mock mode keeps the
# original missing-data checks. The model provider remains mock unless explicitly
# changed to openai_compatible with local credentials.
CNLC_MODE=mock
CNLC_MODEL_PROVIDER=mock
# company_mock: 四个批量能力直接返回既有 Mock；fixture: 原有逐工具演示路径；
# company_real: 真实公司工具链（需在仅本机保存的 .env 中补齐下方公司配置）。
CNLC_PROFESSIONAL_PROVIDER=company_mock
CNLC_MOCK_DATA_DIR=mock_data
CNLC_OUTPUT_DIR=outputs
CNLC_REPORT_STYLE=standard
CNLC_LOG_LEVEL=INFO
CNLC_TOOL_TIMEOUT_SECONDS=10
CNLC_MODEL_TIMEOUT_SECONDS=30
CNLC_MODEL_MAX_RETRIES=2
CNLC_MODEL_RETRY_BACKOFF_SECONDS=0.25
# 首次上传时每个 W 步骤完成后的 SSE 展示停留时间；设为 0 可关闭。
CNLC_STREAM_STEP_DELAY_SECONDS=1
# 报告相邻 Markdown 章节的 SSE 展示间隔；设为 0 可关闭。
CNLC_STREAM_REPORT_CHUNK_DELAY_SECONDS=0.12

# memory = offline demo; postgres-redis = real persistence, no fallback.
CNLC_PERSISTENCE=memory
CNLC_REDIS_PREFIX=cnlc:v1
CNLC_REDIS_TTL_SECONDS=86400
# AgentScope Session / Message 活跃缓存滑动 TTL，独立于运行快照。
CNLC_SESSION_CACHE_TTL_SECONDS=604800
# 未配置表示 Conversation 长期保留；启用时填写正整数天数。
# CNLC_CONVERSATION_RETENTION_DAYS=180
CNLC_INFRASTRUCTURE_TIMEOUT_SECONDS=5

# Set secrets only in your local .env. See docs/05-persistence.md.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=
REDIS_URL=

# OpenAI-compatible model configuration. Keep the key only in local .env.
# For DashScope Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
# DASHSCOPE_API_KEY may be used instead of MODEL_API_KEY.
MODEL_NAME=qwen-plus
# 可选：填写 OTLP/HTTP traces 完整地址（通常以 /v1/traces 结尾）后启用
# AgentScope 原生 Agent / Model / Tool Trace；留空时不启用导出。
OTEL_EXPORTER_OTLP_ENDPOINT=

# 澄清最多保留紧邻下一轮；闲置超过此秒数后清除。
CNLC_CLARIFICATION_TTL_SECONDS=600

# Real company professional tools. Do not commit real addresses, tokens or file paths.
# Authentication: configure either a short-lived token, or all three login fields.
# CNLC_COMPANY_PREPROCESSING_URL=
# CNLC_COMPANY_PREDICTION_URL=
# CNLC_COMPANY_TOKEN=
# CNLC_COMPANY_LOGIN_URL=
# CNLC_COMPANY_USERNAME=
# CNLC_COMPANY_PASSWORD=
# CNLC_COMPANY_GDSX_PATH=
# CNLC_COMPANY_SERVICE_ID=
# CNLC_COMPANY_CREATE_PEOPLE=
# CNLC_COMPANY_PREPROCESS_OPERATIONS={"curves":[],"curveNameStandard":{"enable":false},"curveUnitStandard":{"enable":false},"resample":{"enable":false},"wellCoordinateGenerate":{"enable":false}}
# CNLC_COMPANY_TASK_CONFIG={"CLS":["DZFC","CCHF","JSJL"],"NUM":["POR","SW","PERM","SH","SAND","LIME","DOLO","CARB","ANHY"]}
# CNLC_COMPANY_ENCODING_URL=

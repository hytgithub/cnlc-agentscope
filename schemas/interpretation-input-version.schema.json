{
  "$defs": {
    "CurveManifest": {
      "additionalProperties": false,
      "description": "单条曲线的只读摘要，不包含 values。",
      "properties": {
        "depth_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth End"
        },
        "depth_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Start"
        },
        "depth_step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Step"
        },
        "dimension": {
          "maximum": 4,
          "minimum": 1,
          "title": "Dimension",
          "type": "integer"
        },
        "point_count": {
          "minimum": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "raw_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Raw Name",
          "type": "string"
        },
        "standard_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Name"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "raw_name",
        "point_count",
        "dimension"
      ],
      "title": "CurveManifest",
      "type": "object"
    },
    "DataRequirements": {
      "additionalProperties": false,
      "description": "临时输入资料契约，不代表正式专业解释标准。",
      "properties": {
        "recommended_sources": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Sources",
          "type": "array"
        },
        "required_curves": {
          "items": {
            "type": "string"
          },
          "title": "Required Curves",
          "type": "array"
        }
      },
      "title": "DataRequirements",
      "type": "object"
    },
    "GdsxDatasetManifest": {
      "additionalProperties": false,
      "description": "GDSX 解编后可持久化的小型清单；字段映射等待真实样本确认。",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "curve_count": {
          "minimum": 0,
          "title": "Curve Count",
          "type": "integer"
        },
        "curves": {
          "items": {
            "$ref": "#/$defs/CurveManifest"
          },
          "title": "Curves",
          "type": "array"
        },
        "depth_summary": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Depth Summary",
          "type": "object"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "table_count": {
          "minimum": 0,
          "title": "Table Count",
          "type": "integer"
        },
        "table_names": {
          "items": {
            "type": "string"
          },
          "title": "Table Names",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "well_info_summary": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Well Info Summary",
          "type": "object"
        }
      },
      "required": [
        "artifact_id",
        "size_bytes",
        "content_sha256",
        "curve_count",
        "table_count"
      ],
      "title": "GdsxDatasetManifest",
      "type": "object"
    },
    "InputPayloadKind": {
      "description": "输入正文位置；历史行默认解释为 FIXTURE。",
      "enum": [
        "FIXTURE",
        "GDSX_ARTIFACT"
      ],
      "title": "InputPayloadKind",
      "type": "string"
    },
    "JsonValue": {},
    "LogCurve": {
      "additionalProperties": false,
      "description": "一条测井曲线及其单位和逐深度采样值。",
      "properties": {
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "unit",
        "values"
      ],
      "title": "LogCurve",
      "type": "object"
    },
    "MockFixture": {
      "additionalProperties": false,
      "description": "Demo Fixture，要求所有预设专业结果明确标记 ``is_mock=true``。",
      "properties": {
        "is_mock": {
          "const": true,
          "default": true,
          "title": "Is Mock",
          "type": "boolean"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/StageResult"
          },
          "title": "Outputs",
          "type": "object"
        },
        "raw_data": {
          "$ref": "#/$defs/RawData"
        },
        "requirements": {
          "$ref": "#/$defs/DataRequirements"
        },
        "schema_version": {
          "const": "0.1-skeleton",
          "default": "0.1-skeleton",
          "title": "Schema Version",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ValidationResult"
        },
        "well": {
          "$ref": "#/$defs/Well"
        }
      },
      "required": [
        "well",
        "raw_data",
        "requirements",
        "outputs",
        "validation"
      ],
      "title": "MockFixture",
      "type": "object"
    },
    "RawData": {
      "additionalProperties": false,
      "description": "统一深度轴上的原始测井曲线和辅助资料。",
      "properties": {
        "auxiliary": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Auxiliary",
          "type": "object"
        },
        "curves": {
          "additionalProperties": {
            "$ref": "#/$defs/LogCurve"
          },
          "title": "Curves",
          "type": "object"
        },
        "depth_reference": {
          "const": "MD",
          "default": "MD",
          "title": "Depth Reference",
          "type": "string"
        },
        "depth_unit": {
          "const": "m",
          "default": "m",
          "title": "Depth Unit",
          "type": "string"
        },
        "depths": {
          "items": {
            "type": "number"
          },
          "title": "Depths",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "depths",
        "curves"
      ],
      "title": "RawData",
      "type": "object"
    },
    "StageResult": {
      "additionalProperties": false,
      "description": "各专业阶段共享的结构化结果外壳。",
      "properties": {
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "recommended_action": {
          "default": "continue",
          "title": "Recommended Action",
          "type": "string"
        },
        "result": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Result",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "SUCCESS",
          "enum": [
            "SUCCESS",
            "WARNING",
            "BLOCKED",
            "FAILED",
            "REVIEW_REQUIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "is_mock",
        "source"
      ],
      "title": "StageResult",
      "type": "object"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "description": "W09 多源验证结果，可提出回退目标但不能直接改写解释结论。",
      "properties": {
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "recommended_action": {
          "default": "continue",
          "title": "Recommended Action",
          "type": "string"
        },
        "result": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Result",
          "type": "object"
        },
        "rollback_target": {
          "anyOf": [
            {
              "enum": [
                "W06",
                "W07"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Target"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "SUCCESS",
          "enum": [
            "SUCCESS",
            "WARNING",
            "BLOCKED",
            "FAILED",
            "REVIEW_REQUIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "is_mock",
        "source",
        "validation_status"
      ],
      "title": "ValidationResult",
      "type": "object"
    },
    "ValidationStatus": {
      "description": "多源资料综合验证结论。",
      "enum": [
        "CONSISTENT",
        "PARTIAL_CONFLICT",
        "SERIOUS_CONFLICT",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "ValidationStatus",
      "type": "string"
    },
    "Well": {
      "additionalProperties": false,
      "description": "井基础信息；未冻结字段放入 extensions，避免提前扩张 Schema。",
      "properties": {
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "well_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Well Id",
          "type": "string"
        }
      },
      "required": [
        "well_id",
        "name"
      ],
      "title": "Well",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "持续任务下的输入事实；Fixture 与 Artifact 路径互斥并保持旧数据兼容。",
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/GdsxDatasetManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_version_id": {
      "minLength": 1,
      "title": "Input Version Id",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/MockFixture"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "payload_kind": {
      "$ref": "#/$defs/InputPayloadKind",
      "default": "FIXTURE"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Id"
    },
    "source_type": {
      "enum": [
        "UPLOAD",
        "FIXTURE"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "well_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Well Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "well_id",
    "sequence",
    "source_type",
    "content_sha256"
  ],
  "title": "InterpretationInputVersion",
  "type": "object"
}

{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "可持久化、可展示的结构化错误。",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "step_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "InterpretationStage": {
      "description": "复用既有规划阶段值，DECODE 别名保持 Demo 的 DATA_DECODE 协议兼容。",
      "enum": [
        "DATA_DECODE",
        "DATA_DECODE",
        "PREPROCESS",
        "INTERPRET",
        "REPORT"
      ],
      "title": "InterpretationStage",
      "type": "string"
    },
    "StageRunStatus": {
      "description": "阶段一次实际执行的生命周期，不承载后续修改造成的有效性变化。",
      "enum": [
        "PENDING",
        "RUNNING",
        "WAITING_CONFIRM",
        "CONFIRMED",
        "FAILED"
      ],
      "title": "StageRunStatus",
      "type": "string"
    },
    "StageTransition": {
      "additionalProperties": false,
      "description": "阶段执行状态审计随 Execution 快照持久化。",
      "properties": {
        "actor": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "after": {
          "$ref": "#/$defs/StageRunStatus"
        },
        "before": {
          "$ref": "#/$defs/StageRunStatus"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after",
        "actor",
        "reason"
      ],
      "title": "StageTransition",
      "type": "object"
    },
    "StageValidity": {
      "description": "当前工作版本对既有阶段结果的有效性判断。",
      "enum": [
        "CURRENT",
        "STALE"
      ],
      "title": "StageValidity",
      "type": "string"
    },
    "StepId": {
      "description": "固定业务流程 W01-W10 的步骤标识。",
      "enum": [
        "W01",
        "W02",
        "W03",
        "W04",
        "W05",
        "W06",
        "W07",
        "W08",
        "W09",
        "W10"
      ],
      "title": "StepId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "某任务某阶段的一次真实执行，refs 仅存逻辑 ID，不包含结果正文。",
  "properties": {
    "applied_change_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Applied Change Ids",
      "type": "array"
    },
    "confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed At"
    },
    "confirmed_by": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed By"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "execution_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "input_refs": {
      "additionalProperties": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 512,
        "minLength": 1
      },
      "title": "Input Refs",
      "type": "object"
    },
    "invalidated_by_change_id": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalidated By Change Id"
    },
    "output_refs": {
      "additionalProperties": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 512,
        "minLength": 1
      },
      "title": "Output Refs",
      "type": "object"
    },
    "stage": {
      "$ref": "#/$defs/InterpretationStage"
    },
    "stale_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale At"
    },
    "stale_reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale Reason"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/StageRunStatus",
      "default": "PENDING"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/StageTransition"
      },
      "title": "Transitions",
      "type": "array"
    },
    "validity": {
      "$ref": "#/$defs/StageValidity",
      "default": "CURRENT"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "execution_id",
    "stage"
  ],
  "title": "StageRun",
  "type": "object"
}

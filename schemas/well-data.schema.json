{
  "$defs": {
    "DataRequirements": {
      "additionalProperties": false,
      "description": "临时输入资料契约，不代表正式专业解释标准。",
      "properties": {
        "recommended_sources": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Sources",
          "type": "array"
        },
        "required_curves": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Curves",
          "type": "array"
        }
      },
      "required": [
        "required_curves"
      ],
      "title": "DataRequirements",
      "type": "object"
    },
    "JsonValue": {},
    "LogCurve": {
      "additionalProperties": false,
      "description": "一条测井曲线及其单位和逐深度采样值。",
      "properties": {
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "unit",
        "values"
      ],
      "title": "LogCurve",
      "type": "object"
    },
    "RawData": {
      "additionalProperties": false,
      "description": "统一深度轴上的原始测井曲线和辅助资料。",
      "properties": {
        "auxiliary": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Auxiliary",
          "type": "object"
        },
        "curves": {
          "additionalProperties": {
            "$ref": "#/$defs/LogCurve"
          },
          "title": "Curves",
          "type": "object"
        },
        "depth_reference": {
          "const": "MD",
          "default": "MD",
          "title": "Depth Reference",
          "type": "string"
        },
        "depth_unit": {
          "const": "m",
          "default": "m",
          "title": "Depth Unit",
          "type": "string"
        },
        "depths": {
          "items": {
            "type": "number"
          },
          "title": "Depths",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "depths",
        "curves"
      ],
      "title": "RawData",
      "type": "object"
    },
    "Well": {
      "additionalProperties": false,
      "description": "井基础信息；未冻结字段放入 extensions，避免提前扩张 Schema。",
      "properties": {
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "well_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Well Id",
          "type": "string"
        }
      },
      "required": [
        "well_id",
        "name"
      ],
      "title": "Well",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "井信息、原始数据和资料要求的统一输入对象。",
  "properties": {
    "raw_data": {
      "$ref": "#/$defs/RawData"
    },
    "requirements": {
      "$ref": "#/$defs/DataRequirements"
    },
    "well": {
      "$ref": "#/$defs/Well"
    }
  },
  "required": [
    "well",
    "raw_data",
    "requirements"
  ],
  "title": "WellData",
  "type": "object"
}

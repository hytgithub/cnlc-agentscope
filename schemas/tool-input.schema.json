{
  "$defs": {
    "JsonValue": {},
    "StepId": {
      "description": "固定业务流程 W01-W10 的步骤标识。",
      "enum": [
        "W01",
        "W02",
        "W03",
        "W04",
        "W05",
        "W06",
        "W07",
        "W08",
        "W09",
        "W10"
      ],
      "title": "StepId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Tool 调用输入，携带任务、追踪、井号和步骤上下文。",
  "properties": {
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "step_id": {
      "$ref": "#/$defs/StepId"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "well_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Well Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "trace_id",
    "well_id",
    "step_id"
  ],
  "title": "ToolInput",
  "type": "object"
}

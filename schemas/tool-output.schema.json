{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "可持久化、可展示的结构化错误。",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "step_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "JsonValue": {},
    "StepId": {
      "description": "固定业务流程 W01-W10 的步骤标识。",
      "enum": [
        "W01",
        "W02",
        "W03",
        "W04",
        "W05",
        "W06",
        "W07",
        "W08",
        "W09",
        "W10"
      ],
      "title": "StepId",
      "type": "string"
    },
    "StepStatus": {
      "description": "Workflow 节点和任务统一使用的状态集合。",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCESS",
        "WARNING",
        "FAILED",
        "BLOCKED",
        "REVIEW_REQUIRED",
        "SKIPPED"
      ],
      "title": "StepStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Tool 标准输出，包含状态、数据、告警、错误和元数据。",
  "properties": {
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/StepStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "ToolOutput",
  "type": "object"
}
